# FreePBX Docker - Environment Configuration
# 複製此檔案為 .env 並修改值
# Copy this file to .env and edit the values

# ========================================
# Database Configuration
# ========================================

# Database user for Asterisk and FreePBX
DB_USER=asterisk

# Database password (CHANGE THIS!)
# 使用強密碼：至少 12 個字元，包含大小寫和特殊字元
# Use strong password: at least 12 chars with uppercase, lowercase, numbers, and symbols
DB_PASS=change_me_to_secure_password

# MySQL root password (CHANGE THIS!)
MYSQL_ROOT_PASSWORD=change_me_root_password

# ========================================
# Database Names
# ========================================

# Main FreePBX configuration database
DBNAME=asterisk

# Call Detail Records database
CDRDBNAME=asteriskcdrdb

# ========================================
# Database Connection
# ========================================

# ⚠️ Using host mode: Use 127.0.0.1 instead of service name
# 使用 host mode 時：使用 127.0.0.1 而不是服務名稱
# - Bridge mode: DBHOST=freepbx_mariadb (service name, automatic DNS)
# - Host mode:   DBHOST=127.0.0.1 (localhost IP)
DBHOST=127.0.0.1

# MariaDB port
DBPORT=3306

# ========================================
# Database Engine
# ========================================

# Database engine (mysql or mysqli)
DBENGINE=mysql

# ========================================
# System Settings
# ========================================

# Timezone
TZ=Asia/Taipei

# Asterisk and FreePBX user/group
USER=asterisk
GROUP=asterisk

# ========================================
# FreePBX/Asterisk Directories
# ========================================

WEBROOT=/var/www/html
ASTETCDIR=/etc/asterisk
ASTMODDIR=/usr/lib64/asterisk/modules
ASTVARLIBDIR=/var/lib/asterisk
ASTAGIDIR=/var/lib/asterisk/agi-bin
ASTSPOOLDIR=/var/spool/asterisk
ASTRUNDIR=/var/run/asterisk
AMPBIN=/var/lib/asterisk/bin
AMPSBIN=/usr/sbin
AMPCGIBIN=/var/www/cgi-bin
AMPPLAYBACK=/var/lib/asterisk/playback

# ========================================
# MariaDB Version (Optional)
# ========================================

# Specify MariaDB version (default: 10.11)
# Change only if you need a different version
MARIADB_VERSION=10.11

# ========================================
# Network Mode (Important for Performance)
# ========================================

# ⚠️ CRITICAL: Use host network mode for better performance and resource efficiency
# 重要：使用 host 模式以獲得更好的性能和資源效率

# Change network_mode in docker-compose.yml from "bridge" to "host"
# 在 docker-compose.yml 中將 network_mode 從 "bridge" 改為 "host"

# Example in docker-compose.yml:
# services:
#   freepbx_server:
#     network_mode: "host"  # ← Change this
#   mariadb:
#     network_mode: "host"  # ← Change this

# ========================================
# Host Mode vs Bridge Mode 說明
# Host Mode vs Bridge Mode Explanation
# ========================================

# 🔴 Bridge Mode (Current Default) - 資源浪費:
# ❌ 額外的網路虛擬化層 - Extra network virtualization layer
# ❌ 埠口映射開銷 - Port mapping overhead
# ❌ 較高的 CPU 使用率 - Higher CPU usage
# ❌ 額外的記憶體消耗 - Extra memory consumption
# ❌ SIP/RTP 協議問題 (NAT 穿透困難) - SIP/RTP issues (NAT traversal difficult)
# ❌ 可能導致資源不足 - May cause resource insufficiency
#
# 症狀 Symptoms:
# - Asterisk 服務經常掉線 | Asterisk service drops frequently
# - 通話質量不穩定 | Unstable call quality
# - 系統 CPU 和記憶體占用高 | High system CPU and memory usage
# - FreePBX 速度變慢 | FreePBX slow to respond

# 🟢 Host Mode (Recommended) - 最佳性能:
# ✅ 直接使用主機網路介面 - Direct host network interface
# ✅ 零網路虛擬化開銷 - Zero network virtualization overhead
# ✅ 最低 CPU 占用 - Minimal CPU usage
# ✅ 最低記憶體消耗 - Minimal memory consumption
# ✅ SIP/RTP 協議完美支持 - Perfect SIP/RTP support
# ✅ 生產環境推薦 - Recommended for production

# 效能對比 Performance Comparison:
# Bridge Mode: CPU ~5-10%, Memory ~200MB overhead
# Host Mode:   CPU ~1-2%, Memory ~50MB overhead
#
# 節省資源 Resource Savings:
# 使用 host mode 可以節省 150MB+ 記憶體和大幅降低 CPU 使用率
# Using host mode saves 150MB+ memory and significantly reduces CPU usage

# ========================================
# 如何啟用 Host Mode / How to Enable Host Mode
# ========================================

# 方法 Method 1: 編輯 docker-compose.yml
# Edit docker-compose.yml 中的 services 部分：
#
# services:
#   freepbx_server:
#     image: freepbx-docker:latest
#     network_mode: "host"        # ← Add this line
#     # Remove or comment out:
#     # ports:
#     #   - "80:80"
#     #   - "443:443"
#     #   - "5060:5060/udp"
#     environment:
#       - DBHOST=127.0.0.1        # Change from freepbx_mariadb to 127.0.0.1
#       - DBPORT=3306
#
#   mariadb:
#     image: mariadb:10.11
#     network_mode: "host"        # ← Add this line
#     # Remove ports mapping when using host mode
#
# 注意事項 Important Notes:
# - 使用 host mode 時，必須在同一主機上運行
# - When using host mode, all services must run on the same host
# - 取消埠口映射（ports），改用 network_mode: "host"
# - Remove port mappings (ports:), use network_mode: "host" instead
# - 修改 DBHOST 從服務名稱 "freepbx_mariadb" 改為 "127.0.0.1"
# - Change DBHOST from service name "freepbx_mariadb" to "127.0.0.1"
# - 確保埠口在主機上未被占用 (80, 443, 5060, 3306 等)
# - Ensure ports are not already in use on the host (80, 443, 5060, 3306, etc.)
